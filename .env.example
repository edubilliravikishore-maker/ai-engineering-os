# AI Engineering OS - Environment Configuration

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_engineering_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL (Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_engineering_os
